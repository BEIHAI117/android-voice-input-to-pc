<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- network to the PC agent -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- long-press dictation -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- the floating ball itself -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- keep-alive foreground service + its notification -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- haptic feedback on press / send -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- start the ball again after reboot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <uses-feature android:name="android.hardware.microphone" android:required="true" />

    <application
        android:name=".App"
        android:allowBackup="false"
        android:icon="@drawable/ic_ball"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.PhoneMic"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".overlay.FloatBallService"
            android:exported="false"
            android:foregroundServiceType="microphone|specialUse">
            <!--
              Both types on purpose. On Android 14+ a `microphone` foreground
              service is rejected with a SecurityException when RECORD_AUDIO is
              not granted *at that moment* — which crashes the whole app. The
              ball can still run without the mic (connection status, commands),
              so it degrades to `specialUse` instead of dying.
            -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Floating dictation ball that stays alive between utterances" />
        </service>

        <receiver
            android:name=".BootReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
